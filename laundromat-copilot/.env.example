# OpenAI API Key - Required for data extraction and memo generation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Places API Key - Optional, enables competitor laundromat data
# Get yours at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=

# Database path (SQLite)
DATABASE_URL="file:./prisma/dev.db"
